# Copy to .env and fill in. Never commit .env or feeds.json.

# Feed list (JSON, see feeds.example.json). Required.
FEEDS_FILE=/config/feeds.json

# Model: a faster-whisper model name or a local CTranslate2 directory.
# small.en is a good CPU default; medium.en or large-v3 need a GPU for live use.
WHISPER_MODEL=small.en
WHISPER_MODEL_DIR=/models
WHISPER_DEVICE=auto          # cpu | cuda | auto
WHISPER_COMPUTE_TYPE=int8    # int8 on CPU, float16 on GPU

# Radio vocabulary biased into decoding (hotwords).
# RADIO_HOTWORDS=10-4 10-8 10-20 10-23 10-31 10-33 10-99 code 2 code 3 code 4 BOLO en route copy dispatch

# Segmentation: silence that ends a transmission, and length limits (seconds).
SILENCE_MS=600
MAX_UTTERANCE_S=25
MIN_UTTERANCE_S=0.6

# Hallucination filters (see radio_transcriber/filters.py).
MAX_NO_SPEECH_PROB=0.6
MIN_AVG_LOGPROB=-1.0
MAX_COMPRESSION_RATIO=2.4

# API access. Strongly recommended when the service is reachable from the internet.
TRANSCRIBER_TOKEN=change-me-to-a-long-random-string
CORS_ORIGINS=*
